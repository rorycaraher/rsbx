#!/usr/bin/env bash
# rsbx: interactive launcher for Claude Code in Docker Sandboxes (sbx).
# Written for bash 3.2, the version macOS ships.
set -eu

OTHER_PATH="+ other path..."
DRY_RUN=0

usage() {
  cat <<EOF
Usage: rsbx [-n|--dry-run] [-h|--help]

Choose an existing sandbox or configure a new one, then launch Claude Code.
Esc goes back one step; Ctrl-C quits.

  -n, --dry-run   Print the sbx command that launches a sandbox, without running it
  -h, --help      Show this help

Environment:
  GIT_PROJECTS_ROOT   Colon-separated directories whose subdirectories are
                      offered as projects to mount (default: ~)
EOF
}

die() {
  printf 'rsbx: %s\n' "$1" >&2
  exit 1
}

require() {
  command -v "$1" >/dev/null 2>&1 && return
  printf 'rsbx: %s is not installed. Install it with:\n  %s\n' "$1" "$2" >&2
  exit 127
}

# Print a command in copy-pasteable form, then replace this process with it.
launch() {
  printf '\n$'
  printf ' %q' "$@"
  printf '\n\n'
  [ "$DRY_RUN" -eq 1 ] && exit 0
  exec "$@"
}

# Print a command in copy-pasteable form, then run it (unless --dry-run).
step() {
  printf '\n$'
  printf ' %q' "$@"
  printf '\n'
  [ "$DRY_RUN" -eq 1 ] && return 0
  "$@"
}

# Runs inside the sandbox as bash -c. Replaces any lines it wrote before, and
# rewrites the env file in place because its directory, /etc, isn't writable.
# The env file is sourced before every shell command in the sandbox.
read -r -d '' IDENTITY_SCRIPT <<'EOF' || true
set -eu
f=/etc/sandbox-persistent.sh
m="# rsbx-git-identity"
tmp=$(mktemp)
grep -vF "$m" "$f" >"$tmp" 2>/dev/null || true
for role in AUTHOR COMMITTER; do
  printf "export GIT_%s_NAME=%q GIT_%s_EMAIL=%q %s\n" \
    "$role" "$RSBX_GIT_NAME" "$role" "$RSBX_GIT_EMAIL" "$m"
done >>"$tmp"
cat "$tmp" >"$f"
rm -f "$tmp"
EOF

# Copy the host's git identity for project directory $2 into sandbox $1.
# Without one, git in the sandbox commits as agent@<sandbox>.docker.internal.
# Reading config from inside the project (not with --global, which skips
# includes) honors include and includeIf "gitdir:..." the way a commit would.
set_git_identity() {
  local dir="$2" name email
  [ -d "$dir" ] || dir="$HOME"
  name=$(git -C "$dir" config user.name 2>/dev/null) || name=""
  email=$(git -C "$dir" config user.email 2>/dev/null) || email=""
  if [ -z "$name" ] || [ -z "$email" ]; then
    gum log --level warn "No git user.name/user.email for $dir; sandbox commits will use git's default identity"
    return 0
  fi
  printf '\n$ sbx exec %q bash -c <set git identity: %s <%s>>\n' "$1" "$name" "$email"
  [ "$DRY_RUN" -eq 1 ] && return 0
  sbx exec -e "RSBX_GIT_NAME=$name" -e "RSBX_GIT_EMAIL=$email" \
    "$1" bash -c "$IDENTITY_SCRIPT" ||
    gum log --level warn "Could not set the git identity in $1"
}

# Give sandbox $1 the host's GitHub token as an sbx secret. The sandbox proxy
# injects it into HTTPS requests to GitHub, so git push and gh work inside
# without 'gh auth login' (gh auth status still reports logged out).
set_github_secret() {
  local token
  if ! command -v gh >/dev/null 2>&1; then
    gum log --level warn "gh is not installed; skipping the GitHub secret (install with: brew install gh)"
    return 0
  fi
  printf '\n$ sbx secret set github --sandbox %q -t "$(gh auth token)"\n' "$1"
  [ "$DRY_RUN" -eq 1 ] && return 0
  if ! token=$(gh auth token 2>/dev/null) || [ -z "$token" ]; then
    gum log --level warn "No GitHub token from 'gh auth token'; run 'gh auth login' on the host, then: sbx secret set github --sandbox $1 -t \"\$(gh auth token)\""
    return 0
  fi
  sbx secret set github --sandbox "$1" -t "$token" >/dev/null ||
    gum log --level warn "Could not set the GitHub secret in $1"
}

# Copy host skills (~/.agents/skills first, then other agents' dirs) into sbx's
# shared store, which each sandbox links into ~/.claude/skills when it starts.
# Re-run on every launch so edits on the host reach the store. Skills deleted
# on the host stay in the store until 'sbx skills rm'.
sync_skills() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '\n$ sbx skills import --force'
    return
  fi
  sbx skills import --force >/dev/null ||
    gum log --level warn "Could not import skills; run 'sbx skills import' to see why"
}

# Run gum with the given arguments, storing its output in ANSWER. Returns 1
# when the user presses Esc, so the caller can go back a step; exits rsbx on
# Ctrl-C. Runs in the current shell (not $(...)) so that the exit is real.
prompt() {
  local status=0
  ANSWER=$(gum "$@") || status=$?
  [ "$status" -ne 130 ] || exit 130
  return "$status"
}

# fzf list picker over stdin, storing the chosen lines in ANSWER. $1 is the
# header; the rest are extra fzf flags. Returns 1 on Esc; exits rsbx on
# Ctrl-C. fzf exits 130 for both, so Esc is rebound to exit 1. (gum filter
# needs two Escs: the first only leaves its search box.) accept-non-empty
# stops Enter returning nothing when the search matches nothing.
pick() {
  local header="$1" status=0
  shift
  ANSWER=$(fzf --height=~50% --layout=reverse --header-first --header="$header" \
    --bind 'esc:become(exit 1)' --bind 'enter:accept-non-empty' "$@") || status=$?
  [ "$status" -ne 130 ] || exit 130
  return "$status"
}

# Yes/no question, defaulting to no. Sets ANSWER to Yes or No; returns 1 on
# Esc. Uses gum choose because gum confirm reports Esc the same as No.
ask() {
  prompt choose --header "$1" --selected No Yes No
}

warn() {
  gum log --level warn "$1" >&2
}

# A step is a function taking no arguments that returns 0 to move forward,
# 1 to go back (Esc), or SKIP when it doesn't apply, which keeps moving in
# the same direction so that going back passes over it too.
#
# Steps run in a conditional context, where bash turns off set -e, so they
# check for errors themselves. Keep side effects out of them: do the work
# after run_steps returns.
SKIP=2

# Run the steps named in $@ in order, letting Esc step backwards. Returns 1
# if the user backs out of the first step.
run_steps() {
  local steps=("$@") i=0 dir=1 status
  while [ "$i" -lt "${#steps[@]}" ]; do
    status=0
    "${steps[$i]}" || status=$?
    case "$status" in
      0) dir=1 ;;
      "$SKIP") ;;
      *) dir=-1 ;;
    esac
    i=$((i + dir))
    [ "$i" -ge 0 ] || return 1
  done
}

# Absolute path of a directory, expanding a leading ~.
resolve_dir() {
  # shellcheck disable=SC2088  # matching a literal tilde typed at a prompt
  case "$1" in
    "~") set -- "$HOME" ;;
    "~/"*) set -- "$HOME/${1#"~/"}" ;;
  esac
  (cd -- "$1" 2>/dev/null && pwd)
}

# $1 with a leading $HOME shown as ~.
tilde() {
  # shellcheck disable=SC2088  # printing a tilde, not expanding one
  case "$1" in
    "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# Set ROOTS from GIT_PROJECTS_ROOT, a colon-separated list like PATH.
load_roots() {
  local entries=() entry dir
  IFS=: read -r -a entries <<EOF
${GIT_PROJECTS_ROOT:-$HOME}
EOF
  ROOTS=()
  for entry in ${entries[@]+"${entries[@]}"}; do
    [ -n "$entry" ] || continue
    if dir=$(resolve_dir "$entry"); then
      ROOTS+=("$dir")
    else
      warn "GIT_PROJECTS_ROOT entry is not a directory: $entry"
    fi
  done
}

# Set DIRS to the projects in ROOTS, and LABELS to how the menu shows each:
# the bare name with one root, otherwise the path (with ~), so that projects
# with the same name in different roots stay distinct.
list_projects() {
  local root dir
  DIRS=()
  LABELS=()
  for root in ${ROOTS[@]+"${ROOTS[@]}"}; do
    for dir in "$root"/*/; do
      [ -d "$dir" ] || continue
      dir="${dir%/}"
      DIRS+=("$dir")
      if [ "${#ROOTS[@]}" -eq 1 ]; then
        LABELS+=("${dir##*/}")
      else
        LABELS+=("$(tilde "$dir")")
      fi
    done
  done
}

# Whether $1 is one of the remaining arguments.
contains() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [ "$item" = "$needle" ] && return 0
  done
  return 1
}

PICKED=()
PICKED_BEFORE=0
WANT_OTHER=0

# Step: choose projects from the roots. Sets PICKED and WANT_OTHER.
step_projects() {
  local start="" label i
  # Preselect the previous picks when coming back, else the project at $PWD.
  # fzf's pos() counts from 1.
  [ "$PICKED_BEFORE" -eq 1 ] || PICKED=("$PWD")
  for ((i = 0; i < ${#DIRS[@]}; i++)); do
    if contains "${DIRS[$i]}" ${PICKED[@]+"${PICKED[@]}"}; then
      start="${start}pos($((i + 1)))+toggle+"
    fi
  done
  [ "$WANT_OTHER" -eq 0 ] || start="${start}pos($((${#DIRS[@]} + 1)))+toggle+"

  pick "Projects to mount (tab selects, enter confirms)" --multi \
    ${start:+--bind "start:${start}first"} \
    < <(printf '%s\n' ${LABELS[@]+"${LABELS[@]}"} "$OTHER_PATH") || return 1

  PICKED=()
  PICKED_BEFORE=1
  WANT_OTHER=0
  while IFS= read -r label; do
    if [ "$label" = "$OTHER_PATH" ]; then
      WANT_OTHER=1
      continue
    fi
    for ((i = 0; i < ${#LABELS[@]}; i++)); do
      [ "${LABELS[$i]}" != "$label" ] || PICKED+=("${DIRS[$i]}")
    done
  done <<EOF
$ANSWER
EOF
}

EXTRA=()

# Step: type in directories outside the roots, if "other path" was chosen.
step_other_paths() {
  local path
  EXTRA=()
  [ "$WANT_OTHER" -eq 1 ] || return "$SKIP"
  while :; do
    # shellcheck disable=SC2088  # literal placeholder text
    prompt input --header "Directory to mount (empty to finish)" \
      --placeholder "~/path/to/project" || return 1
    if [ -z "$ANSWER" ]; then
      [ "${#PICKED[@]}" -eq 0 ] && [ "${#EXTRA[@]}" -eq 0 ] || return 0
      warn "Enter at least one directory"
    elif path=$(resolve_dir "$ANSWER"); then
      contains "$path" ${EXTRA[@]+"${EXTRA[@]}"} || EXTRA+=("$path")
    else
      warn "Not a directory: $ANSWER"
    fi
  done
}

# Step: set PROJECTS to the chosen directories, with the workspace the agent
# starts in first.
step_primary() {
  local path others=()
  PROJECTS=()
  for path in ${PICKED[@]+"${PICKED[@]}"} ${EXTRA[@]+"${EXTRA[@]}"}; do
    contains "$path" ${PROJECTS[@]+"${PROJECTS[@]}"} || PROJECTS+=("$path")
  done
  [ "${#PROJECTS[@]}" -gt 1 ] || return "$SKIP"

  prompt choose --header "Primary workspace (Claude starts here)" "${PROJECTS[@]}" ||
    return 1

  for path in "${PROJECTS[@]}"; do
    [ "$path" = "$ANSWER" ] || others+=("$path")
  done
  PROJECTS=("$ANSWER" "${others[@]}")
}

# Step: set MOUNTS. sbx only accepts :ro on extra workspaces, so the primary
# is always writable.
step_mounts() {
  local path i
  MOUNTS=("${PROJECTS[0]}")
  [ "${#PROJECTS[@]}" -gt 1 ] || return "$SKIP"

  prompt choose --no-limit --header "Mount read-only (none selected: all writable)" \
    "${PROJECTS[@]:1}" || return 1

  for ((i = 1; i < ${#PROJECTS[@]}; i++)); do
    path="${PROJECTS[$i]}"
    if printf '%s\n' "$ANSWER" | grep -Fxq -- "$path"; then
      MOUNTS+=("$path:ro")
    else
      MOUNTS+=("$path")
    fi
  done
}

default_name() {
  local base="${1##*/}"
  base=$(printf '%s' "$base" | tr -c 'A-Za-z0-9.-' '-')
  printf 'claude-%s' "$base"
}

# Step: set NAME.
step_name() {
  local name
  name=$(default_name "${PROJECTS[0]}")
  while :; do
    prompt input --header "Sandbox name" --value "$name" || return 1
    name="$ANSWER"
    if ! printf '%s' "$name" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9.-]+$' || [ "$name" = default ]; then
      warn "Use 2+ letters, numbers, hyphens or periods, starting with a letter or number (not 'default')"
    elif printf '%s\n' "$SANDBOXES" | grep -Fxq -- "$name"; then
      warn "A sandbox named $name already exists"
    else
      NAME="$name"
      return 0
    fi
  done
}

# Step: set CLONE. A .git file marks a linked worktree, which sbx refuses to
# clone from.
step_clone() {
  CLONE=0
  [ -d "${PROJECTS[0]}/.git" ] || return "$SKIP"
  ask "Use clone mode? Claude works on a private clone instead of your checkout" || return 1
  [ "$ANSWER" != Yes ] || CLONE=1
}

# Steps: set LIMITS, CPUS and MEMORY.
step_limits() {
  LIMITS=0
  ask "Set CPU and memory limits?" || return 1
  [ "$ANSWER" != Yes ] || LIMITS=1
}

step_cpus() {
  CPUS=""
  [ "$LIMITS" -eq 1 ] || return "$SKIP"
  prompt input --header "CPUs (empty: all host CPUs)" --placeholder "4" || return 1
  CPUS="$ANSWER"
}

step_memory() {
  MEMORY=""
  [ "$LIMITS" -eq 1 ] || return "$SKIP"
  prompt input --header "Memory (empty: 50% of host memory)" --placeholder "8g" || return 1
  MEMORY="$ANSWER"
}

CREATE_STEPS=(step_projects step_other_paths step_primary step_mounts step_name
  step_clone step_limits step_cpus step_memory)

# Prompt for a new sandbox's settings. Returns 1 if the user backs out.
configure_sandbox() {
  load_roots
  list_projects
  PICKED=()
  PICKED_BEFORE=0
  WANT_OTHER=0
  run_steps "${CREATE_STEPS[@]}"
}

create_sandbox() {
  local flags=()
  [ "$CLONE" -eq 0 ] || flags+=(--clone)
  [ -z "$CPUS" ] || flags+=(--cpus "$CPUS")
  [ -z "$MEMORY" ] || flags+=(--memory "$MEMORY")

  sync_skills
  step sbx create --name "$NAME" ${flags[@]+"${flags[@]}"} claude "${MOUNTS[@]}" ||
    die "could not create sandbox $NAME"
  set_github_secret "$NAME"
  set_git_identity "$NAME" "${PROJECTS[0]}"
  launch sbx run --name "$NAME"
}

# Step: set NAME to the sandbox to open.
step_pick_one() {
  pick "Sandbox to open" < <(printf '%s\n' "$SANDBOXES") || return 1
  NAME="$ANSWER"
}

open_sandbox() {
  local dir=""
  sync_skills
  # Workspaces are mounted at their host paths, so the sandbox's working
  # directory is the primary project on the host too. Skipped in a dry run
  # because exec starts a stopped sandbox.
  [ "$DRY_RUN" -eq 1 ] || dir=$(sbx exec "$NAME" pwd 2>/dev/null) || dir=""
  set_git_identity "$NAME" "$dir"
  launch sbx run --name "$NAME"
}

# Set NAMES to the sandboxes picked; returns 1 on Esc.
pick_sandboxes() {
  local name
  pick "$1 (tab selects, enter confirms)" --multi < <(printf '%s\n' "$SANDBOXES") ||
    return 1
  NAMES=()
  while IFS= read -r name; do
    [ -z "$name" ] || NAMES+=("$name")
  done <<EOF
$ANSWER
EOF
}

step_pick_stop() {
  pick_sandboxes "Sandboxes to stop"
}

step_pick_remove() {
  pick_sandboxes "Sandboxes to remove"
}

# Step: gum replaces sbx's own prompt. --force also deletes a sandbox that's
# in use. No goes back to the list.
step_confirm_remove() {
  ask "Permanently remove ${NAMES[*]}? This works even if in use, and unpushed clone-mode work is lost." ||
    return 1
  [ "$ANSWER" = Yes ]
}

main() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -n | --dry-run) DRY_RUN=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    shift
  done

  require gum "brew install gum"
  require fzf "brew install fzf"
  require sbx "brew trust docker/tap && brew install docker/tap/sbx"

  SANDBOXES=$(sbx ls -q) || die "could not list sandboxes; run 'sbx login' if you are not signed in"

  if [ -z "$SANDBOXES" ]; then
    configure_sandbox || exit 0
    create_sandbox
    return
  fi

  sbx ls
  echo
  # Esc in an action's first prompt comes back here; Esc here quits.
  while :; do
    prompt choose --header "What do you want to do?" \
      "Open an existing sandbox" "Create a new sandbox" "Stop sandboxes" "Remove sandboxes" ||
      exit 0

    case "$ANSWER" in
      "Open an existing sandbox")
        run_steps step_pick_one || continue
        open_sandbox
        ;;
      "Create a new sandbox")
        configure_sandbox || continue
        create_sandbox
        ;;
      "Stop sandboxes")
        run_steps step_pick_stop || continue
        sbx stop "${NAMES[@]}"
        ;;
      "Remove sandboxes")
        run_steps step_pick_remove step_confirm_remove || continue
        sbx rm --force "${NAMES[@]}"
        ;;
    esac
    return
  done
}

main "$@"
